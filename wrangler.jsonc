/**
 * rivaOS: Cloudflare Workers + Static Assets.
 * Docs: https://developers.cloudflare.com/workers/static-assets/
 *
 *   npm install
 *   npm run dev       → http://localhost:8787
 *   npm run deploy    → https://rivaos.<your-subdomain>.workers.dev
 *
 * See README.md → "Deploy to Cloudflare" for the custom domain and contact-form email setup.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rivaos",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",

  // Everything in ./public is served as-is from Cloudflare's edge. The Worker only runs for /api/*.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },

  // Lets Settings → rivaOS Update show which deployment you're on.
  "version_metadata": { "binding": "CF_VERSION" },

  "observability": { "enabled": true },

  "vars": {
    "CONTACT_TO": "rivacomputech@gmail.com",
    "CONTACT_FROM": "website@rivacomputech.com"
  },

  // 5 contact-form messages per minute per visitor IP.
  "ratelimits": [
    { "name": "CONTACT_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ]

  // ── Turn these on once the domain is on Cloudflare (README → "Turn on the contact form") ──
  // Email each enquiry to Devik via Cloudflare Email Routing (the address must be a verified destination):
  // , "send_email": [{ "name": "MAILER", "destination_address": "rivacomputech@gmail.com" }]
  //
  // Also keep a copy of every enquiry in Workers KV (create it with: npx wrangler kv namespace create INBOX):
  // , "kv_namespaces": [{ "binding": "INBOX", "id": "<id printed by the command above>" }]
  //
  // Serve on the real domain (Cloudflare creates the DNS records and certificate):
  // , "routes": [
  //     { "pattern": "rivacomputech.com", "custom_domain": true },
  //     { "pattern": "www.rivacomputech.com", "custom_domain": true }
  //   ]
}
